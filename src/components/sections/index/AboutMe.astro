---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Logic / About Section -->
<section
  id="logic"
  class="py-28 px-4 border-t border-white/10 bg-[#050505]/80 backdrop-blur-sm"
>
  <div class="max-w-7xl mx-auto px-2 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Narrative & Core Principles -->
      <div class="lg:col-span-6 space-y-8 reveal">
        <div>
          <div class="inline-flex items-center gap-2 text-sm font-medium text-gray-400 mb-3">
            <i class="fas fa-user-check text-xs text-gray-400" aria-hidden="true"></i>
            <span>{t("nav.link_logic")}</span>
          </div>
          <h2
            class="text-3xl sm:text-4xl font-bold text-white tracking-tight leading-tight"
            style="text-wrap: balance;"
          >
            {t("logic.title")}
          </h2>
        </div>

        <div class="h-px w-16 bg-white/40"></div>

        <div class="space-y-5 text-gray-300 text-base sm:text-lg leading-relaxed">
          <p>{t("logic.paragraph_1")}</p>
          <p>{t("logic.paragraph_2")}</p>
        </div>

        <!-- Core Traits Unboxed Metadata Row -->
        <div class="pt-2 flex flex-wrap items-center gap-3 text-sm text-gray-300">
          <span class="inline-flex items-center gap-2 font-medium text-white">
            <i class="fas fa-brain text-xs text-gray-400" aria-hidden="true"></i>
            {t("logic.trait_1")}
          </span>
          <span aria-hidden="true" class="text-gray-600">·</span>
          <span class="inline-flex items-center gap-2 font-medium text-white">
            <i class="fas fa-feather-pointed text-xs text-gray-400" aria-hidden="true"></i>
            {t("logic.trait_2")}
          </span>
          <span aria-hidden="true" class="text-gray-600">·</span>
          <span class="inline-flex items-center gap-2 font-medium text-white">
            <i class="fas fa-compass text-xs text-gray-400" aria-hidden="true"></i>
            {t("logic.trait_3")}
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-xl border border-white/10 bg-white/[0.03]">
            <div class="flex items-center gap-2 text-sm font-semibold text-white mb-1.5">
              <i class="fas fa-magnifying-glass-chart text-gray-400 text-xs" aria-hidden="true"></i>
              <span>01. {t("logic.analysis_trait")}</span>
            </div>
            <div class="text-sm text-gray-300">{t("logic.analysis_description")}</div>
          </div>
          <div class="p-5 rounded-xl border border-white/10 bg-white/[0.03]">
            <div class="flex items-center gap-2 text-sm font-semibold text-white mb-1.5">
              <i class="fas fa-layer-group text-gray-400 text-xs" aria-hidden="true"></i>
              <span>02. {t("logic.synthesis_trait")}</span>
            </div>
            <div class="text-sm text-gray-300">{t("logic.synthesis_description")}</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Experience & Career Trajectory -->
      <div class="lg:col-span-6 relative reveal" style="transition-delay: 150ms">
        <div class="rounded-2xl border border-white/10 bg-[#0c0c0c] p-6 sm:p-8">
          <div class="flex items-center justify-between pb-5 mb-6 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <i class="fas fa-briefcase text-sm text-gray-400" aria-hidden="true"></i>
              <h3 class="text-lg font-semibold text-white">
                {t("logic.timeline_title")}
              </h3>
            </div>
          </div>

          <div class="space-y-6 relative before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-px before:bg-white/15">
            {
              [1, 2, 3, 4].map((step) => (
                <div class="relative pl-7">
                  <span class="absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full bg-[#0c0c0c] border-2 border-white/70" />
                  <h4 class="text-sm font-semibold text-white tabular-nums mb-1">
                    {t(`logic.timeline_${step}_title`)}
                  </h4>
                  <p class="text-sm text-gray-300 leading-relaxed">
                    {t(`logic.timeline_${step}_desc`)}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
