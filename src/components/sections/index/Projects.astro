---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projectsTranslate = { ...(t("projects") ?? {}) };
const projects = Object.keys(projectsTranslate)
  .filter((k) => k.includes("project_"))
  .map((k) => {
    const project = projectsTranslate[k];
    return {
      date: project.imageAlt,
      title: project.title,
      desc: project.description,
      tags: project.technologies,
      url: project.href,
      image: project.image,
    };
  });

---

<section
  id="projects"
  class="py-28 px-4 border-t border-white/10 bg-[#050505]/80 backdrop-blur-sm"
>
  <div class="max-w-7xl mx-auto px-2 sm:px-6">
    <div class="flex flex-col md:flex-row md:justify-between md:items-end mb-16 reveal gap-4">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-sm font-medium text-gray-400 mb-3">
          <i class="fas fa-folder-open text-xs text-gray-400" aria-hidden="true"></i>
          <span>{t("nav.link_build")}</span>
        </div>
        <h2
          class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-3"
          style="text-wrap: balance;"
        >
          {projectsTranslate.title}
        </h2>
        <p class="text-gray-300 text-base sm:text-lg leading-relaxed">
          {projectsTranslate.subtitle}
        </p>
      </div>
    </div>

    <div class="divide-y divide-white/10 border-b border-white/10">
      {
        projects.map((project, index) => (
          <article class="group relative border-t border-white/10 hover:bg-white/[0.03] transition-colors duration-300 reveal px-2 sm:px-4">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 py-10 items-center">
              <div class="md:col-span-2 flex items-center justify-start">
                <div class="w-36 h-16 rounded-lg bg-white/[0.04] border border-white/10 p-3 flex items-center justify-center overflow-hidden">
                  <Image
                    src={project.image}
                    alt={project.date || project.title}
                    inferSize={true}
                    class="max-h-10 w-auto object-contain"
                  />
                </div>
              </div>
              <div class="md:col-span-6 space-y-2.5">
                <div class="flex items-center gap-2.5">
                  <span class="text-xs font-semibold text-gray-400 tabular-nums">
                    0{index + 1}.
                  </span>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 group-hover:translate-x-1 transition-transform duration-200"
                  >
                    <h3 class="text-2xl font-bold text-white group-hover:text-gray-200">
                      {project.title}
                    </h3>
                  </a>
                </div>
                <p class="text-gray-300 text-base leading-relaxed">
                  {project.desc}
                </p>
              </div>
              <div class="md:col-span-3 flex justify-start md:justify-end items-center flex-wrap gap-y-1 text-xs sm:text-sm text-gray-400">
                {project.tags.map((tag: string, i: number) => (
                  <>
                    <span class="text-gray-300 font-medium">{tag}</span>
                    {i < project.tags.length - 1 && (
                      <span aria-hidden="true" class="mx-2 text-gray-600">
                        ·
                      </span>
                    )}
                  </>
                ))}
              </div>
              <div class="md:col-span-1 flex justify-end">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${project.title}`}
                  class="w-11 h-11 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-white hover:text-black transition-colors duration-200 shrink-0"
                >
                  <i class="fas fa-arrow-right -rotate-45 text-sm" aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
