---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Hero Section -->
<section
  class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden pt-16"
>
  <div
    class="absolute top-24 right-6 md:right-12 opacity-60 text-xs text-gray-400 text-right hidden md:block tabular-nums leading-relaxed"
  >
    <div class="flex items-center justify-end gap-1.5 text-gray-300 font-medium">
      <i class="fas fa-circle-nodes text-[10px]" aria-hidden="true"></i>
      <span>{t("hero.technical_details.automata_status")}</span>
    </div>
    <div>
      {t("hero.technical_details.ruleset_label")}: <span id="rule-display" class="text-gray-200 font-medium">B3/S23</span>
    </div>
    <div>
      {t("hero.technical_details.generation_label")}: <span id="gen-counter" class="text-gray-200 font-medium">0</span>
    </div>
  </div>

  <div class="text-center z-10 max-w-4xl mx-auto px-4">
    <!-- Clean unboxed metadata kicker with icon and typographic separator -->
    <div
      class="mb-6 flex items-center justify-center gap-2.5 text-sm font-medium text-gray-300 reveal"
    >
      <span class="inline-flex items-center gap-1.5 text-white">
        <i class="fas fa-code text-xs text-gray-400" aria-hidden="true"></i>
        <span>{t("hero.title")}</span>
      </span>
      <span aria-hidden="true" class="text-gray-500">·</span>
      <span class="inline-flex items-center gap-1.5 text-gray-300">
        <i class="fas fa-location-dot text-xs text-gray-400" aria-hidden="true"></i>
        <span>{t("hero.city")}</span>
      </span>
    </div>

    <h1
      class="text-5xl sm:text-7xl md:text-8xl font-bold mb-6 tracking-tight text-white reveal relative leading-[1.05]"
      style="transition-delay: 100ms; text-wrap: balance;"
    >
      <div class="glitch-container">
        <span class="relative z-10">{t("hero.name")}</span>
      </div>
    </h1>

    <p
      class="text-lg md:text-2xl text-gray-300 font-normal leading-relaxed max-w-2xl mx-auto reveal mb-10"
      style="transition-delay: 200ms; text-wrap: balance;"
    >
      {t("hero.tagline")}
    </p>

    <div
      class="flex flex-col sm:flex-row gap-4 justify-center items-center reveal"
      style="transition-delay: 300ms;"
    >
      <a
        href="#projects"
        class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-white text-black font-semibold text-sm rounded-lg hover:bg-gray-200 transition-colors w-full sm:w-auto min-w-[190px] whitespace-nowrap"
      >
        <span>{t("hero.button_projects")}</span>
        <i class="fas fa-arrow-down text-xs" aria-hidden="true"></i>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 border border-white/25 text-white font-semibold text-sm rounded-lg hover:border-white hover:bg-white/5 transition-all w-full sm:w-auto min-w-[190px] whitespace-nowrap"
      >
        <span>{t("hero.button_contact")}</span>
        <i class="fas fa-paper-plane text-xs" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <div class="absolute bottom-10 left-0 w-full text-center pointer-events-none">
    <div
      class="w-px h-14 bg-gradient-to-b from-transparent via-gray-500 to-transparent mx-auto animate-pulse"
    >
    </div>
  </div>
</section>
