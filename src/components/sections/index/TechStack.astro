---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="stack" class="py-24 px-4 relative border-t border-white/10">
  <div class="max-w-7xl mx-auto px-2 sm:px-6">
    <div class="mb-14 reveal max-w-2xl">
      <div class="inline-flex items-center gap-2 text-sm font-medium text-gray-400 mb-3">
        <i class="fas fa-microchip text-xs text-gray-400" aria-hidden="true"></i>
        <span>{t("nav.link_stack")}</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-3"
        style="text-wrap: balance;"
      >
        {t("stack.title")}
      </h2>
      <p class="text-gray-300 text-base sm:text-lg leading-relaxed">
        {t("stack.subtitle")}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <!-- Tech Items -->
      {
        [
          { icon: "fab fa-angular", label: "Angular" },
          { icon: "fab fa-react", label: "React & Astro" },
          { icon: "fab fa-js", label: "TypeScript" },
          { icon: "fab fa-node", label: "Node.js" },
          { icon: "fas fa-database", label: "SQL & NoSQL" },
          { icon: "fab fa-python", label: "Python & Django" },
        ].map((tech, index) => (
          <div
            class="iso-card rounded-xl p-6 flex flex-col items-center justify-center gap-3.5 aspect-square group reveal"
            style={`transition-delay: ${index * 50}ms`}
          >
            <i
              class={`${tech.icon} text-3xl text-gray-300 group-hover:text-white transition-colors`}
              aria-hidden="true"
            />
            <span class="text-sm font-medium text-gray-200 group-hover:text-white transition-colors text-center">
              {tech.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .iso-card {
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .iso-card:hover {
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-4px);
    background: rgba(30, 30, 30, 0.8);
  }
</style>
